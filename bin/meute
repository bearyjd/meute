#!/usr/bin/env bash
#
# meute — review and triage what the fleet produced.
#
#   bin/meute <command> [args]
#
# Commands:
#   doctor                        is this fleet deployable? checks the real scheduling environment
#   install-timers                write and enable systemd user timers for both slots
#   status                        quota, what runs next, this week's activity
#   reports [--new|--all]         list reports with their triage state
#   findings [--new|--all]        one row per finding — the actual unit of decision
#   show <id>                     print a report to stdout and mark it read
#   promote <id> -f <n> [-t T]    turn finding <n> into a tier-3 specced ticket
#   dismiss <id> [-f <n>] -r <reason> [-m <text>]
#                                 record a decision; -r is required and is one of
#                                 false-positive wont-fix out-of-scope duplicate too-large other
#   branches                      tier-3 drafts currently in flight
#   pause [--for 3d] [-r why]     stand the fleet down; every slot declines until it expires
#   resume                        lift the pause early
#   help
#
# A report id is its path under reports/ without the .md, e.g.
#   netlens-android/audit-security-2026-08-28
# Anything this tool prints as an id can be passed straight back to it.
#
# This tool never invokes an engine, never edits repos.yaml, and never pushes.
#
set -Eeuo pipefail

readonly MEUTE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export MEUTE_ROOT
readonly MANIFEST_PY="${MEUTE_ROOT}/lib/manifest.py"
readonly REPORT_PY="${MEUTE_ROOT}/lib/report.py"
if [[ -n "${MEUTE_MANIFEST:-}" ]]; then
  readonly MANIFEST="$MEUTE_MANIFEST"
elif [[ -f "${MEUTE_ROOT}/repos.local.yaml" ]]; then
  readonly MANIFEST="${MEUTE_ROOT}/repos.local.yaml"
else
  readonly MANIFEST="${MEUTE_ROOT}/repos.yaml"
fi
readonly STATE_DIR="${MEUTE_ROOT}/state"
readonly REPORTS_DIR="${MEUTE_ROOT}/reports"
readonly LOG_FILE="${STATE_DIR}/log"
readonly CURSOR_FILE="${STATE_DIR}/cursor"
readonly REPORT_STATE="${STATE_DIR}/reports"
readonly LOCK_FILE="${STATE_DIR}/.lock"
readonly HOLD_FILE="${STATE_DIR}/hold"
readonly THIS_WEEK="$(date +%G-%V)"

source "${MEUTE_ROOT}/lib/state.sh"
source "${MEUTE_ROOT}/lib/fleet.sh"
source "${MEUTE_ROOT}/lib/preflight.sh"

SCRUBBED=""
AUTH_MODE=""
ENGINE_ENV=()

note() { printf 'meute: %s\n' "$*" >&2; }
die()  { printf 'meute: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,26p' "${BASH_SOURCE[0]}" | sed 's/^#\( \|$\)//'; }

# --------------------------------------------------------------------------
# Reports on disk are the source of truth. state/reports only annotates them:
# a report with no row is `new`, and a row whose file is gone is ignored.
# --------------------------------------------------------------------------
report_path()  { printf '%s/%s.md\n' "$REPORTS_DIR" "$1"; }

report_ids() {
  [[ -d "$REPORTS_DIR" ]] || return 0
  find "$REPORTS_DIR" -mindepth 2 -maxdepth 2 -name '*.md' -type f 2>/dev/null \
    | sed "s|^${REPORTS_DIR}/||; s|\.md$||" | sort
}

report_state() {
  local row; row="$(kv_row "$REPORT_STATE" "$1")"
  [[ -n "$row" ]] && awk -F'\t' '{print $2}' <<< "$row" || printf 'new\n'
}

mark() {
  local id="$1" state="$2" note_text="${3:-}"
  kv_set_row "$REPORT_STATE" "$id" "$state" "$(date --iso-8601=seconds)" "$note_text"
}

require_report() {
  local id="$1"
  [[ -n "$id" ]] || die "missing report id (try: meute reports)"
  [[ -f "$(report_path "$id")" ]] || die "no such report: ${id}"
}

# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------
cmd_status() {
  fleet_load_policy || die "could not read policy from ${MANIFEST}"
  local quota; quota="$("${MEUTE_ROOT}/bin/quota.sh" 2>/dev/null || echo '?')"

  local gate="ok"
  [[ "$quota" != "?" ]] && (( quota < QUOTA_FLOOR )) && gate="BELOW FLOOR ${QUOTA_FLOOR}%"
  # A hold overrides the gate, so it is the first thing said. A paused fleet
  # reading "quota 100% · ok" is how you conclude it is about to run.
  if hold_active; then
    printf 'PAUSED until %s%s\n' "$(hold_until_human "$HOLD_UNTIL")" "${HOLD_REASON:+ — ${HOLD_REASON}}"
    printf '  every slot declines until then; lift it with: meute resume\n'
  fi
  printf 'quota %s%%  ·  %s\n' "$quota" "$gate"

  local slot
  for slot in daily weekly; do
    printf '  next %-7s %s\n' "$slot" "$(next_for_slot "$slot")"
  done

  local total community cost
  total="$(week_runs)"; community="$(week_runs community)"
  cost="$(awk -F'\t' -v wk="week=${THIS_WEEK}" '
      index($0, wk) == 0 { next }
      { for (i = 1; i <= NF; i++) if ($i ~ /^cost=/) { split($i, a, "="); if (a[2] + 0 > 0) s += a[2] } }
      END { printf "%.2f", s + 0 }' "$LOG_FILE" 2>/dev/null || echo 0)"
  local ceiling=""
  fleet_wire_self_budget >/dev/null 2>&1 || true
  [[ -n "${MEUTE_WEEKLY_COST_USD:-}" ]] && ceiling=" of \$${MEUTE_WEEKLY_COST_USD}"
  [[ -n "${MEUTE_WEEKLY_RUNS:-}" ]] && ceiling=" (ceiling ${MEUTE_WEEKLY_RUNS} runs)"
  printf '  week %s   %s runs (%s personal · %s community) · $%s%s\n' \
    "$THIS_WEEK" "$total" "$(( total - community ))" "$community" "$cost" "$ceiling"

  local in_flight=0
  if fleet_load_scope 2>/dev/null; then in_flight="$(tier3_in_flight 2>/dev/null || echo 0)"; fi
  printf '  tier-3 in flight  %s of %s\n' "${in_flight:-0}" "${TIER3_CAP}"

  local new_count; new_count="$(cmd_reports --new 2>/dev/null | grep -c '^NEW' || true)"
  printf '  reports unread    %s\n' "${new_count:-0}"
}

# What the round-robin would pick next, without running anything.
next_for_slot() {
  local slot="$1" cursor start=0 index total
  local -a queue
  mapfile -t queue < <(python3 "$MANIFEST_PY" queue "$MANIFEST" "$slot" 2>/dev/null || true)
  total=${#queue[@]}
  (( total )) || { printf -- '-\n'; return 0; }
  cursor="$(kv_get "$CURSOR_FILE" "cursor.${slot}")"
  if [[ -n "$cursor" ]]; then
    for (( index = 0; index < total; index++ )); do
      if [[ "$(jq -r '.key' <<< "${queue[index]}")" == "$cursor" ]]; then start=$(( (index + 1) % total )); break; fi
    done
  fi
  jq -r '.key' <<< "${queue[start]}"
}

# A report is a row; a decision is made per finding. Promoting one finding used
# to mark the whole report actioned, which hid every other finding in it — the
# CRITICAL and the HIGH in the same audit are two separate decisions.
readonly SEVERITY_RANK='CRITICAL 0 HIGH 1 MEDIUM 2 LOW 3'

finding_key()   { printf '%s#%s\n' "$1" "$2"; }
finding_state() {
  local row; row="$(kv_row "$REPORT_STATE" "$(finding_key "$1" "$2")")"
  [[ -n "$row" ]] && awk -F'\t' '{print $2}' <<< "$row" || printf 'new\n'
}
mark_finding() {
  kv_set_row "$REPORT_STATE" "$(finding_key "$1" "$2")" "$3" "$(date --iso-8601=seconds)" "${4:-}"
}

# Reasons are a fixed set because they are the only signal for which audit lens
# to retire. Free text alone cannot answer "is this lens noisy or is this repo
# noisy" -- 28 dismissals of "not relevant" and 28 of "false-positive" mean very
# different things.
readonly DISMISS_REASONS="false-positive wont-fix out-of-scope duplicate too-large other"

cmd_findings() {
  local filter="${1:---new}"
  local tmp; tmp="$(mktemp)"
  local id path meta repo n total state sev title loc
  while read -r id; do
    [[ -n "$id" ]] || continue
    path="$(report_path "$id")"
    meta="$(python3 "$REPORT_PY" meta "$path" 2>/dev/null || echo '{}')"
    [[ "$(jq -r '.task // ""' <<< "$meta")" == "audit-security" ]] || continue
    repo="$(jq -r '.repo // "?"' <<< "$meta")"
    total="$(python3 "$REPORT_PY" findings "$path" 2>/dev/null | jq 'length' 2>/dev/null || echo 0)"
    for (( n = 1; n <= total; n++ )); do
      state="$(finding_state "$id" "$n")"
      [[ "$filter" == "--new" && "$state" != "new" ]] && continue
      local f; f="$(python3 "$REPORT_PY" findings "$path" | jq -r --argjson n "$n" '.[] | select(.n == $n) | "\(.severity)\t\(.location)\t\(.title)"')"
      sev="$(cut -f1 <<< "$f")"; loc="$(cut -f2 <<< "$f")"; title="$(cut -f3 <<< "$f")"
      printf '%s\t%s\t%s\t%s#%s\t%s\t%s\n' \
        "$repo" "$(awk -v s="$sev" '{for(i=1;i<=NF;i+=2) if($i==s) print $(i+1)}' <<< "$SEVERITY_RANK")" \
        "$sev" "$id" "$n" "$([[ "$state" == new ]] && echo NEW || echo "$state")" "$title" >> "$tmp"
    done
  done < <(report_ids)

  if [[ ! -s "$tmp" ]]; then rm -f "$tmp"; note "no ${filter#--} findings"; return 0; fi
  # grouped by repo, most severe first inside each group
  sort -t"$(printf '\t')" -k1,1 -k2,2n "$tmp" | awk -F'\t' '
    $1 != last { if (NR > 1) printf "\n"; printf "  %s\n", $1; last = $1 }
    { printf "    %-9s %-9s %-46s %s\n", $5, $3, $4, substr($6, 1, 62) }'
  rm -f "$tmp"
  note "act with: meute promote <id> -f <n>   |   meute dismiss <id> -f <n> -r <reason>"
}

cmd_reports() {
  local filter="${1:---new}"
  local id state summary meta line found=0
  while read -r id; do
    [[ -n "$id" ]] || continue
    state="$(report_state "$id")"
    [[ "$filter" == "--new" && "$state" != "new" ]] && continue
    found=1
    meta="$(python3 "$REPORT_PY" meta "$(report_path "$id")" 2>/dev/null || echo '{}')"
    summary="$(python3 "$REPORT_PY" summary "$(report_path "$id")" 2>/dev/null || echo '-')"
    printf '%-10s %-24s %-16s %-12s %s\n' \
      "$([[ "$state" == new ]] && echo NEW || echo "$state")" \
      "$(jq -r '.repo // "?"' <<< "$meta")" \
      "$(jq -r '.task // "?"' <<< "$meta")" \
      "$(jq -r '.started // "" | split("T")[0]' <<< "$meta")" \
      "$summary"
  done < <(report_ids)
  (( found )) || note "no ${filter#--} reports"
}

# stdout carries the report and nothing else, so `meute show x | bat` works.
cmd_show() {
  local id="${1:-}"; require_report "$id"
  cat "$(report_path "$id")"
  [[ "$(report_state "$id")" == "new" ]] && mark "$id" "read"
  return 0
}

cmd_dismiss() {
  local id="${1:-}"; shift || true
  local reason="" note_text="" number=""
  while (( $# )); do
    case "$1" in
      -r|--reason)  reason="${2:?-r needs a reason}"; shift ;;
      -m|--message) note_text="${2:?-m needs text}"; shift ;;
      -f|--finding) number="${2:?-f needs a finding number}"; shift ;;
      *) die "dismiss: unknown argument $1" ;;
    esac
    shift
  done
  require_report "$id"
  [[ -n "$reason" ]] || die "dismiss: -r <reason> is required, one of: ${DISMISS_REASONS}"
  grep -qw -- "$reason" <<< "$DISMISS_REASONS" \
    || die "dismiss: unknown reason '${reason}'. One of: ${DISMISS_REASONS}"

  if [[ -n "$number" ]]; then
    [[ "$number" =~ ^[0-9]+$ ]] || die "dismiss: -f takes a finding number"
    mark_finding "$id" "$number" "dismissed" "${reason}${note_text:+: ${note_text}}"
    close_report_if_settled "$id"
    note "dismissed finding ${number} of ${id} (${reason})"
  else
    mark "$id" "dismissed" "${reason}${note_text:+: ${note_text}}"
    note "dismissed ${id} (${reason})"
  fi
}

# A report is settled when every finding in it has a decision. Closing it earlier
# hides the findings still waiting.
close_report_if_settled() {
  local id="$1" total n
  total="$(python3 "$REPORT_PY" findings "$(report_path "$id")" 2>/dev/null | jq 'length' 2>/dev/null || echo 0)"
  (( total )) || { mark "$id" "actioned"; return 0; }
  for (( n = 1; n <= total; n++ )); do
    [[ "$(finding_state "$id" "$n")" == "new" ]] && { mark "$id" "read"; return 0; }
  done
  mark "$id" "actioned"
}

cmd_promote() {
  local id="${1:-}"; shift || true
  local number="" title=""
  while (( $# )); do
    case "$1" in
      -f|--finding) number="${2:?-f needs a finding number}"; shift ;;
      -t|--title)   title="${2:?-t needs a title}"; shift ;;
      *) die "promote: unknown argument $1" ;;
    esac
    shift
  done
  require_report "$id"
  [[ "$number" =~ ^[0-9]+$ ]] || die "promote: -f <n> is required (see: meute show ${id})"

  fleet_load_policy || die "could not read policy from ${MANIFEST}"
  fleet_load_scope  || die "could not read the fleet from ${MANIFEST}"
  local in_flight; in_flight="$(tier3_in_flight)"
  (( in_flight < TIER3_CAP )) \
    || die "promote: ${in_flight} tier-3 drafts already in flight (cap ${TIER3_CAP}); merge or drop one first"

  local path meta repo finding
  path="$(report_path "$id")"
  meta="$(python3 "$REPORT_PY" meta "$path")"
  repo="$(jq -r '.repo' <<< "$meta")"
  finding="$(python3 "$REPORT_PY" findings "$path" | jq -c --argjson n "$number" '.[] | select(.n == $n)')"
  [[ -n "$finding" ]] || die "promote: no finding ${number} in ${id}"

  # Take the lock: promote and a concurrent run both write under state/.
  exec 9>"$LOCK_FILE"
  flock -w 10 9 || die "promote: a run holds the lock; try again shortly"

  local payload ticket_id
  payload="$(jq -c -n --arg t "${title:-$(jq -r '.title' <<< "$finding")}" \
    --arg loc "$(jq -r '.location' <<< "$finding")" \
    --arg sev "$(jq -r '.severity' <<< "$finding")" \
    --arg src "$id" \
    --arg created "$(date --iso-8601=seconds)" \
    '{title: $t, specced: true, source: $src, created: $created,
      notes: ("[\($sev)] at \($loc). Promoted from \($src); read that report for the exploit path and consequence before fixing.")}')"
  ticket_id="$(python3 "$MANIFEST_PY" add-ticket "$MANIFEST" "$repo" "$payload")" \
    || die "promote: could not write the ticket"

  mark_finding "$id" "$number" "actioned" "promoted -> ${ticket_id}"
  close_report_if_settled "$id"
  note "ticket ${ticket_id} written to state/tickets.yaml (specced: true)"
  note "tier-3 will pick it up next weekly slot ($(( TIER3_CAP - in_flight - 1 )) of ${TIER3_CAP} slots left)"
}

# Is every change on this branch already present in the base?
#
# Three signals, cheapest first. The third exists because squash-merge — the
# normal way these branches land — rewrites the commit, so the branch is not an
# ancestor of the base and `git branch --merged` will never list it even though
# its content is fully absorbed. Content is the only reliable evidence.
#
# Conservative by construction: a branch is prunable only when it adds NOTHING
# the base lacks. Anything else is kept and reported for a human to look at.
branch_is_absorbed() {
  local repo="$1" branch="$2" base="$3"
  git -C "$repo" merge-base --is-ancestor "$branch" "$base" 2>/dev/null && return 0
  [[ -z "$(git -C "$repo" diff "$base".."$branch" 2>/dev/null)" ]] && return 0
  local unique
  unique="$(git -C "$repo" diff "$base".."$branch" 2>/dev/null | grep -c '^+[^+]' || true)"
  [[ "${unique:-1}" -eq 0 ]]
}

branch_unique_lines() {
  git -C "$1" diff "$3".."$2" 2>/dev/null | grep -c '^+[^+]' || true
}

cmd_branches() {
  fleet_load_policy || die "could not read policy from ${MANIFEST}"
  fleet_load_scope  || die "could not read the fleet from ${MANIFEST}"
  local prune=0
  [[ "${1:-}" == "--prune" ]] && prune=1

  local path branch base found=0 pruned=0 kept=0
  while read -r path; do
    [[ -n "$path" ]] || continue
    [[ -d "$path/.git" || -f "$path/.git" ]] || continue
    # `|| true` is load-bearing: a repo with no origin/HEAD makes this pipeline
    # fail, and under `set -e` with pipefail a failing substitution in an
    # assignment aborts the whole command with no output at all.
    base="$(git -C "$path" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)"
    [[ -n "$base" ]] || base="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [[ -n "$base" ]] || { note "skipping $(basename "$path"): cannot determine a base branch"; continue; }
    while read -r branch date subject; do
      [[ -n "$branch" ]] || continue
      found=1
      if branch_is_absorbed "$path" "$branch" "$base"; then
        if (( prune )); then
          git -C "$path" branch -D "$branch" >/dev/null 2>&1 \
            && { printf '  %-22s %-34s pruned (absorbed into %s)\n' "$(basename "$path")" "$branch" "$base"; pruned=$(( pruned + 1 )); }
        else
          printf '  %-22s %-34s %s  ABSORBED - prunable\n' "$(basename "$path")" "$branch" "$date"
        fi
      else
        printf '  %-22s %-34s %s  %s line(s) not in %s\n' \
          "$(basename "$path")" "$branch" "$date" "$(branch_unique_lines "$path" "$branch" "$base")" "$base"
        kept=$(( kept + 1 ))
      fi
    done < <(git -C "$path" for-each-ref --format='%(refname:short) %(committerdate:short) %(subject)' \
               "refs/heads/${BRANCH_PREFIX}/*" 2>/dev/null)
  done <<< "$REPO_PATHS"

  (( found )) || { note "no scratch branches in flight"; return 0; }
  if (( prune )); then
    note "pruned ${pruned}; kept ${kept} that still carry unique work"
  elif (( kept )); then
    note "${kept} branch(es) hold work not in their base — review before pruning"
    note "run 'meute branches --prune' to delete only the absorbed ones"
  fi
}

# --------------------------------------------------------------------------
# Stand the fleet down. The quota gate measures meute's own spend, not yours —
# see lib/fleet.sh — so when you need the week's capacity for your own work this
# is the only thing that stops the next slot.
# --------------------------------------------------------------------------
cmd_pause() {
  local spec="24h" reason=""
  while (( $# )); do
    case "$1" in
      --for) spec="${2:-}"; [[ -n "$spec" ]] || die "--for needs a duration (45m, 6h, 3d, 2w)"; shift 2 ;;
      -r|--reason) reason="${2:-}"; [[ -n "$reason" ]] || die "-r needs a reason"; shift 2 ;;
      *) die "unknown option: $1 (try: meute pause --for 3d -r 'saving quota for my own work')" ;;
    esac
  done
  local secs; secs="$(hold_duration_seconds "$spec")" \
    || die "bad duration: ${spec} — use 45m, 6h, 3d or 2w, up to a year"

  local until; until=$(( $(now_epoch) + secs ))
  reason="${reason//$'\t'/ }"; reason="${reason//$'\n'/ }"
  kv_set_row "$HOLD_FILE" hold "$until" "$reason"
  note "fleet paused until $(hold_until_human "$until")${reason:+ — ${reason}}"
  note "every slot declines until then. lift it early with:  meute resume"
  note "this hold is local to this machine — state/ is not committed"
}

cmd_resume() {
  if hold_active; then
    local was="$HOLD_UNTIL"
    kv_del "$HOLD_FILE" hold
    note "hold lifted (would have run out $(hold_until_human "$was")); the fleet runs at its next slot"
  else
    kv_del "$HOLD_FILE" hold
    note "no hold in force; the fleet was already free to run"
  fi
}

# --------------------------------------------------------------------------
# Is this fleet actually deployable? Everything here is checked against the
# environment cron will really provide, not the one you are typing in.
# --------------------------------------------------------------------------
readonly CRON_PATH_DEFAULT="/usr/bin:/bin"
DOCTOR_ERRORS=0
DOCTOR_WARNINGS=0

d_ok()   { printf '    \033[32mok\033[0m   %s\n' "$*"; }
d_warn() { printf '    \033[33mwarn\033[0m %s\n' "$*"; DOCTOR_WARNINGS=$(( DOCTOR_WARNINGS + 1 )); }
d_err()  { printf '    \033[31mFAIL\033[0m %s\n' "$*"; DOCTOR_ERRORS=$(( DOCTOR_ERRORS + 1 )); }

# --------------------------------------------------------------------------
# Whether a timer will actually fire. A unit can be `enabled` and inert at the
# same moment: `enable` writes the timers.target.wants symlink, `--now` is what
# starts it, and an `enable --now` whose start half failed leaves exactly that
# state — as does enabling from a shell that cannot reach the user manager.
# `is-enabled` reads the symlink, so it answers "enabled" for a timer with no
# next firing, which is how a fleet reports itself deployable and then never
# runs. The only claim worth checking is the one the scheduler acts on: is
# there a next elapse, and when.
#
# Echoes "<state>\t<detail>":
#   armed  <when>   there is a next firing
#   idle   <state>  loaded, but nothing scheduled — will not run
#   absent          systemd has no such unit
#   nobus           systemd could not be asked
# --------------------------------------------------------------------------
timer_state() {
  local unit="$1" out
  out="$(systemctl --user show "$unit" \
           -p LoadState -p UnitFileState -p ActiveState -p NextElapseUSecRealtime \
           2>/dev/null)" || { printf 'nobus\t\n'; return 0; }
  local load file next
  load="$(sed -n 's/^LoadState=//p'             <<<"$out")"
  file="$(sed -n 's/^UnitFileState=//p'         <<<"$out")"
  next="$(sed -n 's/^NextElapseUSecRealtime=//p' <<<"$out")"
  if [[ "$load" == "not-found" || -z "$load" ]]; then printf 'absent\t\n'; return 0; fi
  # systemd 258 leaves this empty for an inert timer; other versions answer "0"
  # or "n/a". Reading any of them as a time is the false positive this exists
  # to prevent, so all three mean the same thing: nothing is scheduled.
  case "$next" in
    ""|0|n/a) ;;
    *) printf 'armed\t%s\n' "$next"; return 0 ;;
  esac
  printf 'idle\t%s\n' "${file:-unknown}"
}

# yes / no / unknown. `loginctl` needs the *system* bus, which a container does
# not have even when the user bus works; a failed query is not a "no", and
# reporting it as one sends you to a remedy that errors out.
linger_state() {
  local v
  v="$(loginctl show-user "$USER" --property=Linger --value 2>/dev/null)" || { printf 'unknown\n'; return 0; }
  case "$v" in yes|no) printf '%s\n' "$v" ;; *) printf 'unknown\n' ;; esac
}

# Writes and enables systemd user timers. Chosen over cron where cron is absent,
# and better regardless: Persistent=true means a slot missed while the machine
# was off runs at next boot, which plain cron does not do.
cmd_install_timers() {
  command -v systemctl >/dev/null || die "systemd is not available on this machine"
  local unit_dir="${HOME}/.config/systemd/user"
  mkdir -p "$unit_dir"
  local path_line="${HOME}/.local/bin:${HOME}/.npm-global/bin:/usr/bin:/bin"
  local slot
  for slot in daily weekly; do
    local cal="*-*-* 03:17:00"
    [[ "$slot" == weekly ]] && cal="Sat *-*-* 04:41:00"
    cat > "${unit_dir}/meute-${slot}.service" <<UNIT
[Unit]
Description=meute fleet runner (${slot} slot)
Documentation=https://github.com/bearyjd/meute

[Service]
Type=oneshot
WorkingDirectory=${MEUTE_ROOT}
Environment=PATH=${path_line}
ExecStart=${MEUTE_ROOT}/bin/run.sh ${slot}
# stdout and stderr go to the journal; the runner also appends to state/log.
UNIT
    cat > "${unit_dir}/meute-${slot}.timer" <<UNIT
[Unit]
Description=meute ${slot} slot
Documentation=https://github.com/bearyjd/meute

[Timer]
OnCalendar=${cal}
# Run a slot missed while the machine was off, rather than skipping the week.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
UNIT
    note "wrote ${unit_dir}/meute-${slot}.{service,timer}"
  done
  systemctl --user daemon-reload || true
  systemctl --user enable --now meute-daily.timer meute-weekly.timer || true

  # Assert the arming rather than trusting the exit code. The previous version
  # sent this listing to /dev/null, so it printed "0 timers listed" and reported
  # success over two timers that had never been started.
  local slot state detail inert=()
  for slot in daily weekly; do
    IFS=$'\t' read -r state detail <<<"$(timer_state "meute-${slot}.timer")"
    case "$state" in
      armed) note "meute-${slot}.timer armed - next ${detail}" ;;
      *)     note "meute-${slot}.timer is NOT armed (${state}) - it will not fire"
             inert+=( "meute-${slot}.timer" ) ;;
    esac
  done

  case "$(linger_state)" in
    yes) : ;;
    no)  note "WARNING: lingering is off - run 'loginctl enable-linger $USER' or timers only fire while you are logged in" ;;
    *)   note "WARNING: cannot tell whether lingering is on - no system bus reachable from here (a container?)"
         note "         check on the host with:  loginctl show-user $USER --property=Linger" ;;
  esac

  (( ${#inert[@]} == 0 )) || \
    die "units written, but ${inert[*]} not armed. Start them where systemd can be reached:  systemctl --user start ${inert[*]}"
}

cmd_doctor() {
  local missing_from_cron=()

  printf '\n  binaries\n'
  local bin path
  for bin in git jq python3 flock timeout; do
    path="$(command -v "$bin" 2>/dev/null || true)"
    if [[ -z "$path" ]]; then d_err "$bin not found — required"; continue; fi
    if env -i PATH="$CRON_PATH_DEFAULT" sh -c "command -v $bin" >/dev/null 2>&1; then
      d_ok "$(printf '%-8s %s' "$bin" "$path")"
    else
      d_warn "$(printf '%-8s %s  (outside cron PATH)' "$bin" "$path")"
      missing_from_cron+=( "$(dirname "$path")" )
    fi
  done
  for bin in claude codex gh; do
    path="$(command -v "$bin" 2>/dev/null || true)"
    if [[ -z "$path" ]]; then
      [[ "$bin" == "gh" ]] && d_warn "gh not found — the community track needs it" \
                           || d_warn "$bin not found — that engine is unavailable"
      continue
    fi
    if env -i PATH="$CRON_PATH_DEFAULT" sh -c "command -v $bin" >/dev/null 2>&1; then
      d_ok "$(printf '%-8s %s' "$bin" "$path")"
    else
      d_warn "$(printf '%-8s %s  ← NOT on cron PATH; the cron block below fixes this' "$bin" "$path")"
      missing_from_cron+=( "$(dirname "$path")" )
    fi
  done

  printf '\n  auth (probed through the same scrubbed environment the runner uses)\n'
  scrub_env >/dev/null 2>&1
  if command -v claude >/dev/null; then
    if preflight_claude 2>/dev/null; then d_ok "claude   ${AUTH_MODE}"
    else d_err "claude   not on a subscription — run: claude auth login"; fi
  fi
  if command -v codex >/dev/null; then
    if preflight_codex 2>/dev/null; then d_ok "codex    ${AUTH_MODE}"
    else d_warn "codex    not signed in — run: codex login  (only needed for --engine codex)"; fi
  fi
  [[ -n "${SCRUBBED:-}" ]] && d_warn "API keys present and scrubbed: ${SCRUBBED}"

  printf '\n  manifest\n'
  if python3 "$MANIFEST_PY" validate "$MANIFEST" >/dev/null 2>&1; then
    d_ok "$(basename "$MANIFEST") is valid"
    local repos community
    repos="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])) or {}; print(len(d.get('repos') or []))" "$MANIFEST")"
    community="$(python3 -c "import yaml,sys; d=yaml.safe_load(open(sys.argv[1])) or {}; print(len(d.get('community') or []))" "$MANIFEST")"
    if (( repos == 0 && community == 0 )); then
      d_warn "no projects configured — the fleet is inert until you fill in repos.yaml"
    else
      d_ok "${repos} repo(s), ${community} community project(s)"
      local slot
      for slot in daily weekly; do
        d_ok "$(printf '%-7s queue: %s item(s), next: %s' "$slot" \
          "$(python3 "$MANIFEST_PY" queue "$MANIFEST" "$slot" 2>/dev/null | wc -l)" "$(next_for_slot "$slot")")"
      done
    fi
  else
    d_err "$(basename "$MANIFEST") failed validation — run: ./bin/run.sh --validate"
  fi

  printf '\n  quota gate\n'
  local self_budget=0
  # doctor must not die on a broken manifest — it exists to report one.
  fleet_load_policy 2>/dev/null || true
  fleet_wire_self_budget && self_budget=1
  local probe
  if probe="$("${MEUTE_ROOT}/bin/quota.sh" --with-source 2>/dev/null)"; then
    if [[ "${probe#* }" == "stub" ]]; then
      d_warn "${probe%% *}% from the stub — the gate does NOT fire yet"
      d_warn "declare policy.weekly_cost_usd in the manifest, or set MEUTE_QUOTA_CMD"
    elif (( self_budget )); then
      d_ok "${probe%% *}% of meute's own weekly ceiling remaining (${probe#* })"
      d_ok "ceiling: ${MEUTE_WEEKLY_COST_USD:+\$${MEUTE_WEEKLY_COST_USD}}${MEUTE_WEEKLY_RUNS:+${MEUTE_WEEKLY_RUNS} runs}/week, from the manifest"
    else
      d_ok "${probe%% *}% remaining, from ${probe#* }"
    fi
  else
    d_err "quota probe failed — the runner will decline every slot"
  fi

  printf '\n  state\n'
  local dir
  for dir in state reports .worktrees; do
    mkdir -p "${MEUTE_ROOT}/${dir}" 2>/dev/null || true
    [[ -w "${MEUTE_ROOT}/${dir}" ]] && d_ok "${dir}/ writable" || d_err "${dir}/ not writable"
  done
  if git -C "$MEUTE_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    local tracked
    tracked="$(git -C "$MEUTE_ROOT" ls-files state reports | grep -cv '\.gitkeep' || true)"
    if (( tracked > 0 )); then
      d_ok "meute is a git repo; state and reports are auto-committed after each run"
    else
      d_ok "meute is a git repo; state and reports are gitignored, so nothing is committed"
    fi
  else
    d_warn "meute is not a git repo — state and reports will not be committed"
  fi

  if hold_active; then
    d_warn "the fleet is PAUSED until $(hold_until_human "$HOLD_UNTIL")${HOLD_REASON:+ — ${HOLD_REASON}}"
    d_warn "nothing will run until then; lift it with:  ./bin/meute resume"
  fi

  # Not every machine has cron. Immutable Fedora variants ship without cronie,
  # and a crontab block there is instructions that silently never fire.
  printf '\n  scheduling\n'
  local extra
  extra="$(printf '%s\n' "${missing_from_cron[@]:-}" | sort -u | grep -v '^$' | paste -sd: -)"
  local cron_path="${extra:+${extra}:}${CRON_PATH_DEFAULT}"

  if command -v crontab >/dev/null 2>&1; then
    d_ok "cron is available"
    [[ -n "$extra" ]] && printf '    PATH must be set - %s is not on cron'"'"'s default PATH.\n' "$extra"
    printf '\n    # paste into `crontab -e`\n'
    printf '    PATH=%s\n' "$cron_path"
    printf '    17 3 * * *  cd %s && ./bin/run.sh daily  >> state/cron.log 2>&1\n' "$MEUTE_ROOT"
    printf '    41 4 * * 6  cd %s && ./bin/run.sh weekly >> state/cron.log 2>&1\n' "$MEUTE_ROOT"
  elif systemctl --user --version >/dev/null 2>&1; then
    d_warn "no cron on this machine - use systemd user timers"
    case "$(linger_state)" in
      yes) d_ok "lingering enabled - timers fire while you are logged out" ;;
      no)  d_warn "lingering is OFF: user timers will NOT fire unless you are logged in"
           d_warn "enable with:  loginctl enable-linger $USER" ;;
      *)   d_warn "lingering: cannot tell - no system bus reachable from here (a container?)"
           d_warn "check on the host with:  loginctl show-user $USER --property=Linger" ;;
    esac
    local unit_dir="${HOME}/.config/systemd/user"
    if [[ -f "${unit_dir}/meute-daily.timer" ]]; then
      d_ok "units installed in ${unit_dir}"
      local slot state detail
      for slot in daily weekly; do
        IFS=$'\t' read -r state detail <<<"$(timer_state "meute-${slot}.timer")"
        case "$state" in
          armed)  d_ok   "meute-${slot}.timer armed - next ${detail}" ;;
          idle)   d_warn "meute-${slot}.timer is ${detail} on disk but NOT armed: no next firing, so the ${slot} slot will not run"
                  d_warn "arm it with:  systemctl --user start meute-${slot}.timer" ;;
          absent) d_warn "meute-${slot}.timer is not loaded - run:  ./bin/meute install-timers" ;;
          *)      d_warn "meute-${slot}.timer: cannot ask systemd whether it is armed" ;;
        esac
      done
    else
      d_warn "units not installed - run:  ./bin/meute install-timers"
    fi
  else
    d_err "neither cron nor systemd --user is available; nothing can schedule this"
  fi

  printf '\n  %s error(s), %s warning(s)\n\n' "$DOCTOR_ERRORS" "$DOCTOR_WARNINGS"
  (( DOCTOR_ERRORS == 0 ))
}

main() {
  local command="${1:-help}"; shift || true
  command -v jq >/dev/null || die "jq is required"
  case "$command" in
    status)   cmd_status "$@" ;;
    doctor)   cmd_doctor "$@" ;;
    install-timers) cmd_install_timers "$@" ;;
    reports)  cmd_reports "$@" ;;
    findings) cmd_findings "$@" ;;
    show)     cmd_show "$@" ;;
    promote)  cmd_promote "$@" ;;
    dismiss)  cmd_dismiss "$@" ;;
    branches) cmd_branches "$@" ;;
    pause)    cmd_pause "$@" ;;
    resume)   cmd_resume "$@" ;;
    help|--help|-h) usage ;;
    *) die "unknown command: ${command} (try: meute help)" ;;
  esac
}

# Sourcing this file exposes its helpers without running a command, which is
# how the timer and linger logic is tested against a stubbed systemctl.
[[ "${BASH_SOURCE[0]}" != "$0" ]] || main "$@"
