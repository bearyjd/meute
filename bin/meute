#!/usr/bin/env bash
#
# meute — review and triage what the fleet produced.
#
#   bin/meute <command> [args]
#
# Commands:
#   doctor                        is this fleet deployable? checks the real scheduling environment
#   health [--alert]              one line per reason the fleet may have stopped; exits 1 if any.
#                                  --alert also pipes the text to policy.alert_cmd (hourly timer)
#   install-timers                write and enable systemd user timers for both slots, the
#                                  hourly health check, and OnFailure alerts for both run units
#   install-statusline            wrap Claude Code's status line so the real 5h/7d
#                                  subscription windows reach the quota gate
#   status                        quota, what runs next, this week's activity
#   reports [--new|--all]         list reports with their triage state
#   findings [--new|--all] [--json]
#                                 one row per finding — the actual unit of decision;
#                                  --new hides gone, superseded, claimed and inherited rows
#   findings verify [--repo R]    is each new finding's file gone, changed or current
#                                  at the repository's HEAD? (state/finding-status)
#   claim <id> -f <n> --pr <url>  the finding is covered by an open PR
#   show <id>                     print a report to stdout and mark it read
#   promote <id> -f <n> [-t T]    turn finding <n> into a tier-3 specced ticket
#   resolve <id> [-f <n>] -m <text> | --pr <url>
#                                 record that a finding was already fixed directly
#                                 (no ticket) -- -m or --pr is required
#   dismiss <id> [-f <n>] -r <reason> [-m <text>]
#                                 record a decision; -r is required and is one of
#                                 false-positive wont-fix out-of-scope duplicate too-large other
#   branches                      tier-3 drafts currently in flight
#   image bump <repo>             pin the repo's container image: record the digest
#                                  podman has for its image.tag into repos.local.yaml
#   container probe <repo>        start the repo's pinned image over a clone of its
#                                  default branch and report what the agent would see:
#                                  uid, capabilities, /work, /out, the network
#   pause [--for 3d] [-r why]     stand the fleet down; every slot declines until it expires
#   resume                        lift the pause early
#   policy set k=v... --for 8h [-r why]
#                                 override quota_floor_percent, weekly_runs, weekly_cost_usd,
#                                 community_share or tier3_max_in_flight until it expires (7d max)
#   policy show | clear           what is overridden now | drop it early
#                                 (one invocation only: MEUTE_QUOTA_FLOOR=1 bin/run.sh ...)
#   drain <daily|weekly> [--source plan|manifest] [--max N] [--until HH:MM] [--repo R]...
#                                  run the slot unforced, fire after fire (waiting up to
#                                  900 s for the lock), until one full rotation is done,
#                                  the staged plan is drained, or a fire is declined;
#                                  exits with that fire's status (lib/drain.sh)
#   discover [dir]                find git repos under dir (default ~/Documents/vibe-code)
#                                  not yet configured, and interactively add the ones you pick
#   plan [--enqueue [--append|--replace] [--only <repo>]... [--skip-invalid]] [--allow-web] [--json] [dir]
#                                  portfolio inventory and proposed audit plan (writes only the derived state/plan-cache);
#                                  --enqueue stages only read-only work for the normal runner
#                                  (each staged run still cuts a scratch branch and worktree
#                                  in the repository); tasks that reach the web are left out
#                                  unless --allow-web, and a tier that can shell out is never
#                                  staged -- enroll the repository for that instead
#                                  --only stages just the named unconfigured repos (repeatable;
#                                  no tree walk; --skip-invalid stages the good ones, exit 3)
#                                  over unattempted staged work: --append or --replace
#                                  --json prints the inventory and ranking as one JSON object
#                                  defaults to this checkout's parent directory
#   tui                           the triage inbox, in the terminal (PRP-003 screen 1)
#   web [--host H] [--port P] [--insecure-public]
#                                  the inbox in a browser; loopback by default
#   help
#
# A report id is its path under reports/ without the .md, e.g.
#   netlens-android/audit-security-2026-08-28
# Anything this tool prints as an id can be passed straight back to it.
#
# This tool never invokes an engine and never pushes. It reads either manifest
# but only ever WRITES repos.local.yaml (via `discover` and `image bump`) --
# repos.yaml is the tracked, hand-commented schema doc, and `lib/manifest.py`'s
# add-repo and set-image-digest both refuse to touch it.
#
set -Eeuo pipefail
# Owner-only files on a shared host: state/ and reports/ name private repos
# and carry unfixed findings (P2.4). Inherited by `meute web` and its runs.
umask 077

readonly MEUTE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export MEUTE_ROOT
readonly MANIFEST_PY="${MEUTE_ROOT}/lib/manifest.py"
readonly REPORT_PY="${MEUTE_ROOT}/lib/report.py"
readonly INBOX_PY="${MEUTE_ROOT}/lib/inbox.py"
if [[ -n "${MEUTE_MANIFEST:-}" ]]; then
  readonly MANIFEST="$MEUTE_MANIFEST"
elif [[ -f "${MEUTE_ROOT}/repos.local.yaml" ]]; then
  readonly MANIFEST="${MEUTE_ROOT}/repos.local.yaml"
else
  readonly MANIFEST="${MEUTE_ROOT}/repos.yaml"
fi
readonly STATE_DIR="${MEUTE_ROOT}/state"
readonly REPORTS_DIR="${MEUTE_ROOT}/reports"
readonly LOG_FILE="${STATE_DIR}/log"
readonly CURSOR_FILE="${STATE_DIR}/cursor"
readonly REPORT_STATE="${STATE_DIR}/reports"
readonly LOCK_FILE="${STATE_DIR}/.lock"
readonly HOLD_FILE="${STATE_DIR}/hold"
readonly PLAN_QUEUE_FILE="${STATE_DIR}/plan-queue.json"
readonly PLAN_DONE_FILE="${STATE_DIR}/plan-complete"
readonly THIS_WEEK="$(date +%G-%V)"

source "${MEUTE_ROOT}/lib/state.sh"
source "${MEUTE_ROOT}/lib/fleet.sh"
# Before preflight.sh, which builds its host scrub from container.sh's list.
source "${MEUTE_ROOT}/lib/container.sh"
source "${MEUTE_ROOT}/lib/preflight.sh"
source "${MEUTE_ROOT}/lib/plan.sh"
source "${MEUTE_ROOT}/lib/plan_dedup.sh"
source "${MEUTE_ROOT}/lib/quota_age.sh"
source "${MEUTE_ROOT}/lib/plan_cache.sh"
source "${MEUTE_ROOT}/lib/plan_only.sh"
source "${MEUTE_ROOT}/lib/plan_queue_lock.sh"
source "${MEUTE_ROOT}/lib/status.sh"
source "${MEUTE_ROOT}/lib/discover.sh"
source "${MEUTE_ROOT}/lib/doctor.sh"
source "${MEUTE_ROOT}/lib/privacy.sh"
source "${MEUTE_ROOT}/lib/timers.sh"
source "${MEUTE_ROOT}/lib/finding_cmds.sh"
source "${MEUTE_ROOT}/lib/unitlimits.sh"
source "${MEUTE_ROOT}/lib/statusline.sh"
source "${MEUTE_ROOT}/lib/scratch.sh"
source "${MEUTE_ROOT}/lib/tmp.sh"
source "${MEUTE_ROOT}/lib/sweep.sh"
source "${MEUTE_ROOT}/lib/policy_override.sh"
source "${MEUTE_ROOT}/lib/hostcheck.sh"
source "${MEUTE_ROOT}/lib/health.sh"
source "${MEUTE_ROOT}/lib/scope.sh"
source "${MEUTE_ROOT}/lib/drain.sh"

SCRUBBED=""
AUTH_MODE=""
ENGINE_ENV=()

note() { printf 'meute: %s\n' "$*" >&2; }
die()  { printf 'meute: %s\n' "$*" >&2; exit 1; }
# The header comment above, however long it grows: everything after the
# shebang up to the first line that is not a comment.
usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^#( |$)/, ""); print }' "${BASH_SOURCE[0]}"; }

# Device+inode, the only identity that survives a bind mount: /home/<you> and
# /var/home/<you> can be one directory, and neither `pwd -P` nor `readlink -f`
# says so. -L so a symlinked manifest entry names the repo it points at. A
# path absent on disk falls back to its literal spelling -- it must neither
# abort the caller nor collide with anything real.
dir_id() { stat -L -c '%d:%i' -- "$1" 2>/dev/null || printf '%s' "$1"; }

# Is the manifest this tool would write the tracked repos.yaml? By identity,
# not by name, for the same reason as dir_id: a symlink with any other
# basename resolves to it, and every writer follows the link. Prints where
# the manifest resolves to, so a refusal can say which file it protected;
# lib/manifest.py's writers make the same test again on their own.
manifest_resolves_to() { readlink -f -- "$MANIFEST" 2>/dev/null || printf '%s\n' "$MANIFEST"; }
manifest_is_tracked() {
  local real; real="$(manifest_resolves_to)"
  [[ "$(basename -- "$real")" == "repos.yaml" || "$real" -ef "${MEUTE_ROOT}/repos.yaml" ]]
}

# --------------------------------------------------------------------------
# Reports on disk are the source of truth. state/reports only annotates them:
# a report with no row is `new`, and a row whose file is gone is ignored.
# --------------------------------------------------------------------------
report_path()  { printf '%s/%s.md\n' "$REPORTS_DIR" "$1"; }

report_ids() {
  [[ -d "$REPORTS_DIR" ]] || return 0
  find "$REPORTS_DIR" -mindepth 2 -maxdepth 2 -name '*.md' -type f 2>/dev/null \
    | sed "s|^${REPORTS_DIR}/||; s|\.md$||" | sort
}

report_state() {
  local row; row="$(kv_row "$REPORT_STATE" "$1")"
  [[ -n "$row" ]] && awk -F'\t' '{print $2}' <<< "$row" || printf 'new\n'
}

mark() {
  local id="$1" state="$2" note_text="${3:-}"
  kv_set_row "$REPORT_STATE" "$id" "$state" "$(date --iso-8601=seconds)" "$note_text"
}

require_report() {
  local id="$1"
  [[ -n "$id" ]] || die "missing report id (try: meute reports)"
  [[ -f "$(report_path "$id")" ]] || die "no such report: ${id}"
}

# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------

# A report is a row; a decision is made per finding. Promoting one finding used
# to mark the whole report actioned, which hid every other finding in it — the
# CRITICAL and the HIGH in the same audit are two separate decisions.
readonly SEVERITY_RANK='CRITICAL 0 HIGH 1 MEDIUM 2 LOW 3'

finding_key()   { printf '%s#%s\n' "$1" "$2"; }
finding_state() {
  local row; row="$(kv_row "$REPORT_STATE" "$(finding_key "$1" "$2")")"
  [[ -n "$row" ]] && awk -F'\t' '{print $2}' <<< "$row" || printf 'new\n'
}
mark_finding() {
  kv_set_row "$REPORT_STATE" "$(finding_key "$1" "$2")" "$3" "$(date --iso-8601=seconds)" "${4:-}"
}

# Reasons are a fixed set because they are the only signal for which audit lens
# to retire. Free text alone cannot answer "is this lens noisy or is this repo
# noisy" -- 28 dismissals of "not relevant" and 28 of "false-positive" mean very
# different things.
readonly DISMISS_REASONS="false-positive wont-fix out-of-scope duplicate too-large other"

cmd_findings() {
  [[ "${1:-}" == verify ]] && { shift; cmd_findings_verify "$@"; return; }
  local filter="--new" json=0
  while (( $# )); do
    case "$1" in
      --new|--all) filter="$1" ;;
      --json) json=1 ;;
      *) die "findings: unknown argument $1" ;;
    esac
    shift
  done
  if (( json )); then
    python3 "$INBOX_PY" findings "$filter" --json || die "findings failed: lib/inbox.py exited with an error (see above)"
    return 0
  fi
  # Under state/tmp, not $TMPDIR, and gone however the command ends.
  tmp_init "$STATE_DIR"; trap tmp_cleanup EXIT
  local tmp; tmp="$(mktemp)"
  # One process reads every report; the shell only sorts and lays out.
  # A crash must not read as "no findings": stderr stays visible and the exit
  # status is non-zero.
  if ! python3 "$INBOX_PY" findings "$filter" --tsv > "$tmp"; then
    rm -f "$tmp"; die "findings failed: lib/inbox.py exited with an error (see above)"
  fi

  if [[ ! -s "$tmp" ]]; then rm -f "$tmp"; note "no ${filter#--} findings"; return 0; fi
  # grouped by repo, most severe first inside each group
  sort -t"$(printf '\t')" -k1,1 -k2,2n "$tmp" | awk -F'\t' '
    $1 != last { if (NR > 1) printf "\n"; printf "  %s\n", $1; last = $1 }
    { printf "    %-9s %-9s %-46s %s\n", $5, $3, $4, substr($6, 1, 62) }'
  rm -f "$tmp"
  note "act with: meute promote <id> -f <n>   |   meute dismiss <id> -f <n> -r <reason>"
}

cmd_reports() {
  local filter="${1:---new}"
  local id state summary meta line found=0
  while read -r id; do
    [[ -n "$id" ]] || continue
    state="$(report_state "$id")"
    [[ "$filter" == "--new" && "$state" != "new" ]] && continue
    found=1
    meta="$(python3 "$REPORT_PY" meta "$(report_path "$id")" 2>/dev/null || echo '{}')"
    summary="$(python3 "$REPORT_PY" summary "$(report_path "$id")" 2>/dev/null || echo '-')"
    printf '%-10s %-24s %-16s %-12s %s\n' \
      "$([[ "$state" == new ]] && echo NEW || echo "$state")" \
      "$(jq -r '.repo // "?"' <<< "$meta")" \
      "$(jq -r '.task // "?"' <<< "$meta")" \
      "$(jq -r '.started // "" | split("T")[0]' <<< "$meta")" \
      "$summary"
  done < <(report_ids)
  (( found )) || note "no ${filter#--} reports"
}

# stdout carries the report and nothing else, so `meute show x | bat` works.
cmd_show() {
  local id="${1:-}"; require_report "$id"
  cat "$(report_path "$id")"
  [[ "$(report_state "$id")" == "new" ]] && mark "$id" "read"
  return 0
}

# For when a finding got fixed directly (a PR against the target repo,
# outside meute's own tier-3 draft flow) rather than promoted into a ticket
# for the fleet to draft later. Same shape as cmd_dismiss, but the outcome is
# "actioned", not "dismissed" -- dismissing a finding that was actually fixed
# would record the opposite of what happened.
cmd_resolve() {
  local id="${1:-}"; shift || true
  local number="" note_text="" pr=""
  while (( $# )); do
    case "$1" in
      -f|--finding) number="${2:?-f needs a finding number}"; shift ;;
      -m|--message) note_text="${2:?-m needs text}"; shift ;;
      --pr) pr="${2:?--pr needs a URL}"; shift ;;
      *) die "resolve: unknown argument $1" ;;
    esac
    shift
  done
  require_report "$id"
  if [[ -n "$pr" ]]; then
    valid_pr_url "$pr" || die "resolve: --pr must be an http(s) URL with no spaces"
    note_text="${note_text:+${note_text} }pr: ${pr}"
  fi
  [[ -n "$note_text" ]] || die "resolve: -m <text> or --pr <url> is required (what was done)"

  if [[ -n "$number" ]]; then
    [[ "$number" =~ ^[0-9]+$ ]] || die "resolve: -f takes a finding number"
    mark_finding "$id" "$number" "actioned" "resolved: ${note_text}"
    close_report_if_settled "$id"
    note "resolved finding ${number} of ${id}"
  else
    mark "$id" "actioned" "resolved: ${note_text}"
    note "resolved ${id}"
  fi
}

cmd_dismiss() {
  local id="${1:-}"; shift || true
  local reason="" note_text="" number=""
  while (( $# )); do
    case "$1" in
      -r|--reason)  reason="${2:?-r needs a reason}"; shift ;;
      -m|--message) note_text="${2:?-m needs text}"; shift ;;
      -f|--finding) number="${2:?-f needs a finding number}"; shift ;;
      *) die "dismiss: unknown argument $1" ;;
    esac
    shift
  done
  require_report "$id"
  [[ -n "$reason" ]] || die "dismiss: -r <reason> is required, one of: ${DISMISS_REASONS}"
  grep -qw -- "$reason" <<< "$DISMISS_REASONS" \
    || die "dismiss: unknown reason '${reason}'. One of: ${DISMISS_REASONS}"

  if [[ -n "$number" ]]; then
    [[ "$number" =~ ^[0-9]+$ ]] || die "dismiss: -f takes a finding number"
    mark_finding "$id" "$number" "dismissed" "${reason}${note_text:+: ${note_text}}"
    close_report_if_settled "$id"
    note "dismissed finding ${number} of ${id} (${reason})"
  else
    mark "$id" "dismissed" "${reason}${note_text:+: ${note_text}}"
    note "dismissed ${id} (${reason})"
  fi
}

# A report is settled when every finding in it has a decision. Closing it earlier
# hides the findings still waiting.
close_report_if_settled() {
  local id="$1" total n
  total="$(python3 "$REPORT_PY" findings "$(report_path "$id")" 2>/dev/null | jq 'length' 2>/dev/null || echo 0)"
  (( total )) || { mark "$id" "actioned"; return 0; }
  for (( n = 1; n <= total; n++ )); do
    [[ "$(finding_state "$id" "$n")" == "new" ]] && { mark "$id" "read"; return 0; }
  done
  mark "$id" "actioned"
}

cmd_promote() {
  local id="${1:-}"; shift || true
  local number="" title=""
  while (( $# )); do
    case "$1" in
      -f|--finding) number="${2:?-f needs a finding number}"; shift ;;
      -t|--title)   title="${2:?-t needs a title}"; shift ;;
      *) die "promote: unknown argument $1" ;;
    esac
    shift
  done
  require_report "$id"
  [[ "$number" =~ ^[0-9]+$ ]] || die "promote: -f <n> is required (see: meute show ${id})"

  fleet_load_policy || die "could not read policy from ${MANIFEST}"
  fleet_load_scope  || die "could not read the fleet from ${MANIFEST}"
  local in_flight; in_flight="$(tier3_in_flight)"
  (( in_flight < TIER3_CAP )) \
    || die "promote: ${in_flight} tier-3 drafts already in flight (cap ${TIER3_CAP}); merge or drop one first"

  local path meta repo finding
  path="$(report_path "$id")"
  meta="$(python3 "$REPORT_PY" meta "$path")"
  repo="$(jq -r '.repo' <<< "$meta")"
  finding="$(python3 "$REPORT_PY" findings "$path" | jq -c --argjson n "$number" '.[] | select(.n == $n)')"
  [[ -n "$finding" ]] || die "promote: no finding ${number} in ${id}"

  # Take the lock: promote and a concurrent run both write under state/.
  exec 9>"$LOCK_FILE"
  flock -w 10 9 || die "promote: a run holds the lock; try again shortly"

  local payload ticket_id
  payload="$(jq -c -n --arg t "${title:-$(jq -r '.title' <<< "$finding")}" \
    --arg loc "$(jq -r '.location' <<< "$finding")" \
    --arg sev "$(jq -r '.severity' <<< "$finding")" \
    --arg src "$id" \
    --arg created "$(date --iso-8601=seconds)" \
    '{title: $t, specced: true, source: $src, created: $created,
      notes: ("[\($sev)] at \($loc). Promoted from \($src); read that report for the exploit path and consequence before fixing.")}')"
  ticket_id="$(python3 "$MANIFEST_PY" add-ticket "$MANIFEST" "$repo" "$payload")" \
    || die "promote: could not write the ticket"

  mark_finding "$id" "$number" "actioned" "promoted -> ${ticket_id}"
  close_report_if_settled "$id"
  note "ticket ${ticket_id} written to state/tickets.yaml (specced: true)"

  # Writing the ticket is not the same as it ever being drafted -- that needs
  # some task in this repo's own list to actually consume specced tickets.
  # Found the hard way: BB-1 sat promoted for a repo with no draft-ticket task
  # wired up at all, and this command said nothing about it.
  local slot picked=0 queue_out
  for slot in daily weekly; do
    # Merging stderr in (rather than the 2>/dev/null used elsewhere) is
    # deliberate: cmd_queue in lib/manifest.py never writes anything but JSON
    # lines to stdout on success, so a real failure here must not read the
    # same as "no task consumes this ticket" -- that would be the same
    # mistake as detail=success for an is_error:true run, just in this file.
    queue_out="$(python3 "$MANIFEST_PY" queue "$MANIFEST" "$slot" 2>&1)" \
      || die "promote: could not verify the ${slot} queue: ${queue_out}"
    if jq -e --arg r "$repo" --arg t "$ticket_id" \
         'select(.repo == $r and .ticket_id == $t)' <<< "$queue_out" >/dev/null 2>&1; then
      picked=1; break
    fi
  done
  if (( picked )); then
    note "tier-3 will pick it up next weekly slot ($(( TIER3_CAP - in_flight - 1 )) of ${TIER3_CAP} slots left)"
  else
    note "WARNING: ${repo} has no task wired to draft specced tickets -- ${ticket_id} will sit unpicked"
    note "  add a ticket-consuming task (e.g. draft-ticket) to ${repo}'s task list in ${MANIFEST}"
  fi
}

# Is every change on this branch already present in the base?
#
# Three signals, cheapest first. The third exists because squash-merge — the
# normal way these branches land — rewrites the commit, so the branch is not an
# ancestor of the base and `git branch --merged` will never list it even though
# its content is fully absorbed. Content is the only reliable evidence.
#
# Conservative by construction: a branch is prunable only when it adds NOTHING
# the base lacks. Anything else is kept and reported for a human to look at.
branch_is_absorbed() {
  local repo="$1" branch="$2" base="$3"
  git -C "$repo" merge-base --is-ancestor "$branch" "$base" 2>/dev/null && return 0
  [[ -z "$(git -C "$repo" diff "$base".."$branch" 2>/dev/null)" ]] && return 0
  local unique
  unique="$(git -C "$repo" diff "$base".."$branch" 2>/dev/null | grep -c '^+[^+]' || true)"
  [[ "${unique:-1}" -eq 0 ]]
}

branch_unique_lines() {
  git -C "$1" diff "$3".."$2" 2>/dev/null | grep -c '^+[^+]' || true
}

cmd_branches() {
  fleet_load_policy || die "could not read policy from ${MANIFEST}"
  fleet_load_scope  || die "could not read the fleet from ${MANIFEST}"
  local prune=0 as_json=0
  [[ "${1:-}" == "--prune" ]] && prune=1
  # --json: one object per line for lib/inbox.py. The git logic that decides
  # "absorbed" lives here and nowhere else, so the TUI asks rather than copies.
  [[ "${1:-}" == "--json" ]] && as_json=1

  local path branch base found=0 pruned=0 kept=0
  while read -r path; do
    [[ -n "$path" ]] || continue
    [[ -d "$path/.git" || -f "$path/.git" ]] || continue
    # `|| true` is load-bearing: a repo with no origin/HEAD makes this pipeline
    # fail, and under `set -e` with pipefail a failing substitution in an
    # assignment aborts the whole command with no output at all.
    base="$(git -C "$path" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)"
    [[ -n "$base" ]] || base="$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [[ -n "$base" ]] || { note "skipping $(basename "$path"): cannot determine a base branch"; continue; }
    while read -r branch date subject; do
      [[ -n "$branch" ]] || continue
      found=1
      if (( as_json )); then
        local absorbed=false; branch_is_absorbed "$path" "$branch" "$base" && absorbed=true
        jq -cn --arg repo "$(basename "$path")" --arg branch "$branch" --arg date "$date" \
               --arg subject "$subject" --arg base "$base" --argjson absorbed "$absorbed" \
               --argjson lines "$(branch_unique_lines "$path" "$branch" "$base")" \
               '{repo:$repo, branch:$branch, date:$date, subject:$subject, base:$base, absorbed:$absorbed, unique_lines:$lines}'
        continue
      fi
      if branch_is_absorbed "$path" "$branch" "$base"; then
        if (( prune )); then
          git -C "$path" branch -D "$branch" >/dev/null 2>&1 \
            && { printf '  %-22s %-34s pruned (absorbed into %s)\n' "$(basename "$path")" "$branch" "$base"; pruned=$(( pruned + 1 )); }
        else
          printf '  %-22s %-34s %s  ABSORBED - prunable\n' "$(basename "$path")" "$branch" "$date"
        fi
      else
        printf '  %-22s %-34s %s  %s line(s) not in %s\n' \
          "$(basename "$path")" "$branch" "$date" "$(branch_unique_lines "$path" "$branch" "$base")" "$base"
        kept=$(( kept + 1 ))
      fi
    done < <(git -C "$path" for-each-ref --format='%(refname:short) %(committerdate:short) %(subject)' \
               "refs/heads/${BRANCH_PREFIX}/*" 2>/dev/null)
  done <<< "$REPO_PATHS"

  (( as_json )) && return 0
  (( found )) || { note "no scratch branches in flight"; return 0; }
  if (( prune )); then
    note "pruned ${pruned}; kept ${kept} that still carry unique work"
  elif (( kept )); then
    note "${kept} branch(es) hold work not in their base — review before pruning"
    note "run 'meute branches --prune' to delete only the absorbed ones"
  fi
}

# --------------------------------------------------------------------------
# Containers (PRP-004). podman lives in lib/container.sh, sourced above with
# the rest: one file owns the boundary, so widening it is a diff against that
# file. Nothing here starts a container except `container probe`, which is
# run by a human -- a timer fire still cannot dispatch one before Phase 2b.
# --------------------------------------------------------------------------
# The only writer of image.digest. Reads the tag from the manifest as it is --
# a manifest that needs this is exactly one rule 1 rejects today, tag set and
# digest not -- and lets set-image-digest validate the manifest as it will be.
cmd_image_bump() {
  local repo="${1:-}"
  [[ -n "$repo" ]] || die "image bump: which repo? (try: meute image bump <name>)"
  ! manifest_is_tracked \
    || die "image bump: refusing to write repos.yaml$([[ "$(manifest_resolves_to)" == "$MANIFEST" ]] || printf ' (%s resolves to %s)' "$MANIFEST" "$(manifest_resolves_to)") (tracked schema doc, hand-commented) -- create repos.local.yaml first: cp repos.yaml repos.local.yaml"
  local row tag
  row="$(python3 "$MANIFEST_PY" list-images "$MANIFEST" | jq -c --arg r "$repo" 'select(.name == $r)')" \
    || die "image bump: could not read ${MANIFEST}"
  [[ -n "$row" ]] || die "image bump: unknown repo '${repo}' - not in $(basename "$MANIFEST")"
  tag="$(jq -r '.tag' <<< "$row")"
  [[ -n "$tag" ]] \
    || die "image bump: ${repo} has no image.tag - set it first (Atelier's agent-${repo}:g<sha>); the digest pins that tag"
  podman_available \
    || die "image bump: podman not found (MEUTE_PODMAN=${MEUTE_PODMAN:-unset}) - resolved to '$(podman_cmd)'; point MEUTE_PODMAN at the host's podman"
  local digest
  digest="$(image_digest_on_host "$tag")" \
    || die "image bump: podman has no image ${tag} - build it with Atelier first ($(podman_cmd) image ls)"
  [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] \
    || die "image bump: podman answered '${digest}' for ${tag}, not a sha256 digest"
  python3 "$MANIFEST_PY" set-image-digest "$MANIFEST" "$repo" "$digest" >/dev/null \
    || die "image bump: the digest was not written"
  note "${repo}: image.digest -> ${digest:0:19}… for ${tag}"
  note "backup of the previous manifest: $(basename -- "$(manifest_resolves_to)").bak"
}

# --------------------------------------------------------------------------
# `meute container probe <repo>` -- what Phase 2b will do, minus the engine.
#
# It asserts the pin, cuts the §4.2 clone of the repo's default branch, and
# runs one container over a fixed diagnostic script with no network at all.
# That is the whole isolation boundary answered from inside it, without a
# credential and without an engine: a human can check a repo is
# container-ready today, and the suite drives this same path.
# --------------------------------------------------------------------------
readonly CONTAINER_PROBE_SCRIPT='
printf "uid %s\n" "$(id -u)"
printf "gid %s\n" "$(id -g)"
case "$(awk "/^CapBnd/{print \$2}" /proc/self/status)" in
  0000000000000000) printf "capabilities none\n" ;;
  *) printf "capabilities %s -- NOT empty\n" "$(awk "/^CapBnd/{print \$2}" /proc/self/status)" ;;
esac
case "$(awk "/^NoNewPrivs/{print \$2}" /proc/self/status)" in
  1) printf "no-new-privs yes\n" ;;
  *) printf "no-new-privs NO\n" ;;
esac
printf "home %s\n" "$HOME"
if git -C /work status --porcelain >/dev/null 2>&1; then
  printf "git in /work ok (%s, %s)\n" "$(git -C /work rev-parse --abbrev-ref HEAD)" "$(git -C /work rev-parse --short HEAD)"
else
  printf "git in /work FAILED\n"
fi
printf "branches in /work %s\n" "$(git -C /work for-each-ref --format="%(refname:short)" refs/heads | tr "\n" " ")"
if touch /out/.probe 2>/dev/null; then printf "/out writable\n"; rm -f /out/.probe; else printf "/out NOT writable\n"; fi
if getent hosts example.com >/dev/null 2>&1; then printf "dns RESOLVED -- the network is open\n"; else printf "dns blocked\n"; fi
'

cmd_container_probe() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "container probe: which repo? (try: meute container probe <name>)"
  local row
  row="$(python3 "$MANIFEST_PY" list-images "$MANIFEST" | jq -c --arg r "$name" 'select(.name == $r)')" \
    || die "container probe: could not read ${MANIFEST}"
  [[ -n "$row" ]] || die "container probe: unknown repo '${name}' - not in $(basename "$MANIFEST")"
  [[ "$(jq -r '.runtime' <<< "$row")" == "container" ]] \
    || die "container probe: ${name} runs on the host (runtime: host) - nothing to probe"

  local path default_branch
  path="$(python3 "$MANIFEST_PY" list-repos "$MANIFEST" | jq -r --arg r "$name" 'select(.name == $r) | .path')"
  [[ -d "$path/.git" || -f "$path/.git" ]] || die "container probe: ${path} is not a git repository"
  default_branch="$(repo_default_branch "$path")"

  # The entry the container code consumes. Built here rather than taken from
  # the queue on purpose: the probe answers "is this repo container-ready",
  # which must not depend on a task being scheduled for it today.
  local entry
  entry="$(jq -cn --arg repo "$name" --arg tag "$(jq -r '.tag' <<< "$row")" \
    --arg digest "$(jq -r '.digest' <<< "$row")" \
    '{repo:$repo, runtime:"container", image:{tag:$tag, digest:$digest},
      network:"none", timeout_seconds:120}')"
  container_ready "$entry" || die "container probe: ${CONTAINER_BLOCKED}"

  # Globals, and an EXIT trap: the scratch tree must go whether the probe
  # finishes, dies on a failed clone, or is interrupted -- and a RETURN trap
  # cannot read a local that has already gone out of scope under `set -u`.
  # The trap goes up with the FIRST directory, not after the second: a failed
  # second mktemp would otherwise leak the first.
  PROBE_SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/meute-probe-XXXXXX")"
  trap 'rm -rf "${PROBE_SCRATCH:-}" "${PROBE_OUT:-}" "${CONTAINER_PIDDIR:-}"' EXIT
  PROBE_OUT="$(mktemp -d "${TMPDIR:-/tmp}/meute-probe-out-XXXXXX")"
  # The clone is the point: what the agent sees is a repository of its own,
  # holding one branch, and never the owner's checkout.
  scratch_clone "$path" "$PROBE_SCRATCH" "$default_branch" "meute/probe-$(date +%F)" HEAD \
    || die "container probe: could not cut a scratch clone of ${path}"

  note "probing ${name} with $(jq -r '.tag' <<< "$row") at the pinned digest, network none"
  note "  scratch clone: $(git -C "$PROBE_SCRATCH" rev-parse --short HEAD) on $(git -C "$PROBE_SCRATCH" rev-parse --abbrev-ref HEAD)"
  # No engine: the probe runs a diagnostic script, so no credential is
  # mounted and none should be.
  container_run "$entry" probe "" "$PROBE_SCRATCH" "$PROBE_OUT" -- sh -c "$CONTAINER_PROBE_SCRIPT" \
    || die "container probe: the container did not run to completion"
}

cmd_container() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    probe) cmd_container_probe "$@" ;;
    *)     die "container: unknown subcommand '${sub}' (try: meute container probe <repo>)" ;;
  esac
}

cmd_image() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    bump) cmd_image_bump "$@" ;;
    *)    die "image: unknown subcommand '${sub}' (try: meute image bump <repo>)" ;;
  esac
}

# --------------------------------------------------------------------------
# Stand the fleet down. The quota gate measures meute's own spend, not yours —
# see lib/fleet.sh — so when you need the week's capacity for your own work this
# is the only thing that stops the next slot.
# --------------------------------------------------------------------------
cmd_pause() {
  local spec="24h" reason=""
  while (( $# )); do
    case "$1" in
      --for) spec="${2:-}"; [[ -n "$spec" ]] || die "--for needs a duration (45m, 6h, 3d, 2w)"; shift 2 ;;
      -r|--reason) reason="${2:-}"; [[ -n "$reason" ]] || die "-r needs a reason"; shift 2 ;;
      *) die "unknown option: $1 (try: meute pause --for 3d -r 'saving quota for my own work')" ;;
    esac
  done
  local secs; secs="$(hold_duration_seconds "$spec")" \
    || die "bad duration: ${spec} — use 45m, 6h, 3d or 2w, up to a year"

  local until; until="$(hold_set "$secs" "$reason")"
  note "fleet paused until $(hold_until_human "$until")${reason:+ — ${reason}}"
  note "every slot declines until then. lift it early with:  meute resume"
  note "this hold is local to this machine — state/ is not committed"
}

cmd_resume() {
  if hold_active; then
    local was="$HOLD_UNTIL"
    hold_clear
    note "hold lifted (would have run out $(hold_until_human "$was")); the fleet runs at its next slot"
  else
    hold_clear
    note "no hold in force; the fleet was already free to run"
  fi
}

cmd_policy() {
  local sub="${1:-show}"; shift || true
  case "$sub" in
    set) policy_override_set "$@" ;;
    show) policy_override_show || note "no policy override in force; the manifest's policy applies" ;;
    clear) policy_override_clear; note "policy override cleared; the manifest's policy applies" ;;
    *) die "unknown policy command: ${sub} (try: meute policy set|show|clear)" ;;
  esac
}

# Inventory a directory tree without enrolling anything (only the derived
# state/plan-cache is written), and optionally stage the result for the
# runner. The work lives in lib/plan.sh; this is the command line.
cmd_plan() {
  local enqueue=0 allow_web=0 json=0 skip_invalid=0 mode="" requested="" scan_dir
  local -a only=()
  while (( $# )); do
    case "$1" in
      --enqueue) enqueue=1 ;;
      --append|--replace) [[ -z "$mode" || "$mode" == "${1#--}" ]] \
          || { note "plan: --append and --replace are exclusive"; exit 2; }; mode="${1#--}" ;;
      --skip-invalid) skip_invalid=1 ;;
      --allow-web) allow_web=1 ;;
      --json) json=1 ;;
      --only) (( $# >= 2 )) || die "plan: --only needs a path"; only+=( "$2" ); shift ;;
      --) shift; [[ $# -eq 1 ]] || die "plan: expected at most one directory"; requested="$1"; break ;;
      -*) die "plan: unknown option: $1" ;;
      *) [[ -z "$requested" ]] || die "plan: expected at most one directory"; requested="$1" ;;
    esac
    shift
  done
  # Usage errors exit 2, apart from the runtime refusals that exit 1.
  (( ${#only[@]} == 0 || enqueue )) || { note "plan: --only requires --enqueue"; exit 2; }
  (( ! json || ! enqueue )) || { note "plan: --json only reports and cannot be combined with --enqueue"; exit 2; }
  [[ -z "$mode" ]] || (( enqueue )) || { note "plan: --${mode} requires --enqueue"; exit 2; }
  (( ! skip_invalid || ${#only[@]} )) || { note "plan: --skip-invalid requires --only"; exit 2; }
  (( ! enqueue )) || plan_queue_guard "$mode"
  requested="${requested:-$(dirname "$MEUTE_ROOT")}"
  scan_dir="$(cd "$requested" 2>/dev/null && pwd)" || die "plan: no such directory: ${requested}"
  # A manifest the runner would refuse is not one to plan against.
  python3 "$MANIFEST_PY" validate "$MANIFEST" >/dev/null || die "plan: manifest failed validation"

  # Four levels finds normal project layouts (portfolio/client/project) while
  # avoiding a surprise full-home scan.  An operator can deliberately raise it
  # for a deeper tree without making the default unbounded; sixteen is past
  # any layout and into "scan the whole disk" territory.
  local max_depth="${MEUTE_PLAN_MAX_DEPTH:-4}"
  [[ "$max_depth" =~ ^[1-9][0-9]*$ ]] && (( max_depth <= 16 )) \
    || die "plan: MEUTE_PLAN_MAX_DEPTH must be an integer from 1 to 16"

  plan_collect_tasks "$allow_web"
  plan_cache_load
  if (( ${#only[@]} )); then
    # Named paths only (lib/plan_only.sh): no walk, every refusal collected.
    plan_only_precheck "$scan_dir" "${only[@]}"
    plan_only_scan "$scan_dir"
  else
    plan_scan_repos "$scan_dir" "$max_depth"
    # One canonical copy per repository; copies are listed, never staged.
    plan_dedup "$scan_dir"
  fi
  plan_cache_save
  if (( json )); then
    plan_print_json "$scan_dir"
    return 0
  fi
  if (( ${#PLAN_REJECTED[@]} )); then
    plan_only_report
    (( skip_invalid )) || die "plan: ${#PLAN_REJECTED[@]} --only path(s) refused; nothing staged (--skip-invalid stages the rest)"
    (( ${#PLAN_UNCONFIGURED[@]} )) || die "plan: every --only path was refused; nothing staged"
  fi
  plan_print "$scan_dir" "$max_depth"
  if (( enqueue )); then
    plan_stage "$scan_dir" "$allow_web" "$mode"
    # 3: staged, but not everything that was asked for.
    (( ${#PLAN_REJECTED[@]} == 0 )) || exit 3
  else
    printf '\nNo manifest or repository was changed (state/plan-cache is derived and safe to delete). Stage this exact plan for the runner with: meute plan --enqueue %s (the analysis is read-only, but each staged run cuts a scratch branch and a worktree in that repository while it works).\n' "$scan_dir"
  fi
}

# The triage UI lives in its own uv venv under tui/. PRP-003's hard
# invariant: the runner has no dependency on it -- bin/run.sh must succeed on
# a machine where this venv was never created, so nothing here is sourced by
# run.sh and the venv is created only on demand.
tui_python() {
  local venv="${MEUTE_ROOT}/tui/.venv"
  if [[ ! -x "${venv}/bin/python" ]]; then
    command -v uv >/dev/null || die "the triage UI needs uv (https://docs.astral.sh/uv/) to create its venv"
    note "creating the triage UI's venv under tui/.venv (one-time)"
    ( cd "${MEUTE_ROOT}/tui" && uv sync -q ) || die "uv sync failed under tui/"
  fi
  printf '%s\n' "${venv}/bin/python"
}

cmd_tui() {
  local py; py="$(tui_python)"
  exec "$py" "${MEUTE_ROOT}/tui/app.py"   # MEUTE_ROOT is already exported
}

# `meute web` serves the stdlib web inbox (tui/webserver.py, plain python3, no
# venv). It has a per-process token and Host/Origin checks but no login, and it
# can start fleet runs, so a non-loopback bind requires an explicit
# acknowledgement. The server only accepts requests whose Host header is the
# bound host:port, so a non-loopback bind must use the address the browser uses.
cmd_web() {
  local host="127.0.0.1" port="8642" insecure_public=0
  while (( $# )); do
    case "$1" in
      --host) (( $# >= 2 )) || die "web: --host needs a value"; host="$2"; [[ "$host" != --* ]] || die "web: --host needs a value, got '${host}'"; shift ;;
      --port) port="${2:?--port needs a value}"; [[ "$port" != --* ]] || die "web: --port needs a value, got '${port}'"; shift ;;
      --insecure-public) insecure_public=1 ;;
      *) die "web: unknown argument $1" ;;
    esac
    shift
  done
  [[ "$port" =~ ^[0-9]+$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) \
    || die "web: --port must be an integer 1-65535, got '${port}'"
  # The server accepts only Host == the bound host:port, and no browser sends
  # Host 0.0.0.0: a wildcard bind would answer every request with 403.
  case "$host" in
    ""|0|0.0.0.0|"*") die "web: --host '${host}' is a wildcard bind, which cannot work (the server only accepts the exact bound host:port as Host); bind the specific address the browser will use, e.g. a LAN or tailnet IP, with --insecure-public" ;;
  esac
  # The server binds an IPv4 socket; an IPv6 literal (::1, ::) cannot work.
  [[ "$host" != *:* ]] || die "web: IPv6 host ${host} is not supported; use an IPv4 address (127.0.0.1 is the default)"
  if [[ "$host" != "127.0.0.1" && "$host" != "localhost" ]]; then
    (( insecure_public )) || die "web: refusing non-loopback host ${host}; pass --insecure-public to acknowledge the unauthenticated inbox"
    note "WARNING: binding ${host} -- there is no login; anyone who can reach it can triage findings AND start fleet runs that spend your Claude/Codex quota. Open the link printed below, with the address exactly as shown (the Host check only accepts the bound host:port)"
  fi
  note "starting the inbox: open the link printed below, it carries the access token (Ctrl-C to stop)"
  exec python3 "${MEUTE_ROOT}/tui/webserver.py" --host "$host" --port "$port"
}

main() {
  local command="${1:-help}"; shift || true
  command -v jq >/dev/null || die "jq is required"
  case "$command" in
    status)   cmd_status "$@" ;;
    doctor)   cmd_doctor "$@" ;;
    health)   cmd_health "$@" ;;
    install-timers) cmd_install_timers "$@" ;;
    install-statusline) cmd_install_statusline "$@" ;;
    reports)  cmd_reports "$@" ;;
    findings) cmd_findings "$@" ;;
    show)     cmd_show "$@" ;;
    promote)  cmd_promote "$@" ;;
    resolve)  cmd_resolve "$@" ;;
    claim)    cmd_claim "$@" ;;
    dismiss)  cmd_dismiss "$@" ;;
    branches) cmd_branches "$@" ;;
    image)    cmd_image "$@" ;;
    container) cmd_container "$@" ;;
    pause)    cmd_pause "$@" ;;
    resume)   cmd_resume "$@" ;;
    policy)   cmd_policy "$@" ;;
    drain)    cmd_drain "$@" ;;
    discover) cmd_discover "$@" ;;
    plan)     cmd_plan "$@" ;;
    tui)      cmd_tui "$@" ;;
    web)      cmd_web "$@" ;;
    help|--help|-h) usage ;;
    *) die "unknown command: ${command} (try: meute help)" ;;
  esac
}

# Sourcing this file exposes its helpers without running a command, which is
# how the timer and linger logic is tested against a stubbed systemctl.
[[ "${BASH_SOURCE[0]}" != "$0" ]] || main "$@"
