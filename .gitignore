# Scratch checkouts; created and removed within a single run.
.worktrees/
# Lock and temp files; state/cursor, state/log and reports/ ARE committed.
state/.lock
state/.cursor.*
.omc/
# Your real fleet config: names your projects and describes what they do.
# The harness is public; that list is yours.
repos.local.yaml

# Everything about YOUR fleet stays local. The harness is public; what it
# found in your private code, and which repos it even looks at, is not.
# reports/ carries verbatim file paths, config values and unfixed vulnerability
# detail. state/ names your repos and their tasks.
reports/*/
state/log
state/cursor
state/reports
state/tickets.yaml
state/quota-override
state/hold
