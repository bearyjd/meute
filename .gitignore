# Scratch checkouts; created and removed within a single run.
.worktrees/
# Lock and temp files. Only state/.gitkeep and reports/.gitkeep are tracked;
# the fleet's own state/cursor, state/log and reports/ are ignored below.
state/.lock
state/.kv.*
.omc/
# Your real fleet config: names your projects and describes what they do.
# The harness is public; that list is yours.
repos.local.yaml
# `manifest.py add-repo` writes this before every edit, so `meute discover`
# is recoverable. It is a copy of the gitignored manifest; it stays out too.
repos.local.yaml.bak

# Everything about YOUR fleet stays local. The harness is public; what it
# found in your private code, and which repos it even looks at, is not.
# reports/ carries verbatim file paths, config values and unfixed vulnerability
# detail. state/ names your repos and their tasks.
reports/*/
state/log
state/cursor
state/reports
state/tickets.yaml
state/quota-override
# A staged portfolio plan lists every unconfigured repo on the machine by
# absolute path; its archives and mktemp leftovers carry the same list.
state/plan-queue.json
state/plan-complete
state/plan-queue.completed-*
state/.plan-*
# The subscription windows, snapshotted by contrib/statusline-capture.sh.
state/rate-limits.json
state/hold
# Where each in-flight tier-3 ticket stands (PRP-004 §4.3): one row per
# <repo>/<ticket> naming its stage, branch, base SHA and build report.
state/stages

# The triage UI's own venv (uv-managed). The runner never touches it.
tui/.venv/
__pycache__/
